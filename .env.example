# Copy to .env.local for local work. Every value here is a placeholder, never commit a filled in copy.

# UploadThing (file uploads) - get from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your_uploadthing_token_here

# Firebase client config
# Get these from: Firebase Console > Project Settings > Your Apps > Firebase SDK snippet

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin, server side only. Required in production.
# Locally you can leave these unset and put a service-account-key.json at the project root instead, see lib/firebase-admin.ts.
# The private key is a single line with literal \n escapes, which the app expands at startup.

FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY=your_private_key

# Deadline sweep cron (app/api/cron/sweep). Vercel Cron sends this as a Bearer token automatically once set, and any request without a match gets a 401.
CRON_SECRET=your_cron_secret_here

# Public origin for OG tags and canonical URLs (app/layout.tsx).
# Leave unset in production so it falls back to the live domain, and set it on preview deploys so they advertise themselves.
NEXT_PUBLIC_SITE_URL=
